{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pak-spotlight-ary-preview",
  "main": "src/ary-preview-worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
