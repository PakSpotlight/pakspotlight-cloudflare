{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pak-spotlight",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "classictvpakistan.com", "custom_domain": true },
    { "pattern": "www.classictvpakistan.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash"
  }
}
