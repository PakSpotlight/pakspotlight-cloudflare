{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pak-spotlight",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
