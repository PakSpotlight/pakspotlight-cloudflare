{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pak-spotlight-watch-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash-lite"
  }
}
