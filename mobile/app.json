{
  "expo": {
    "name": "Classic TV Pakistan",
    "slug": "classic-tv-pakistan",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "classictvpakistan",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.classictvpakistan.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "classictvpakistan.com",
              "pathPrefix": "/watch"
            },
            {
              "scheme": "https",
              "host": "classictvpakistan.com",
              "pathPrefix": "/drama"
            },
            {
              "scheme": "https",
              "host": "www.classictvpakistan.com",
              "pathPrefix": "/watch"
            }
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "5a58c420-baf7-416e-916e-662f551a71ff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 23,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash.png",
          "imageWidth": 220
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
